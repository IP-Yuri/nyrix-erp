# ==============================================================
# NYRIX ERP - Environment Variables Configuration
# ==============================================================
# Copy this file to .env for local testing or enter these values
# into your Cloud Provider's Environment Variables dashboard (Render, Koyeb, etc.).
# NEVER commit your actual .env file with real production secrets!
# ==============================================================

# --- DATABASE CONFIGURATION ---
# For PostgreSQL (e.g. Neon.tech, Supabase, Render Postgres):
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/nyrix_db
# (If left empty, the application will fallback to local SQLite: sqlite:///./nyrix_dev.db)

# --- SECURITY & JWT CONFIGURATION ---
# A strong random 64-character secret key for signing JWT tokens.
# Generate one on Linux/macOS with: openssl rand -hex 32
# Or on PowerShell with: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 32 | % {[char]$_})
SECRET_KEY=replace_with_a_super_secret_production_key_here

# JWT Algorithm (default: HS256)
ALGORITHM=HS256

# JWT Access Token Expiration in minutes (e.g., 720 = 12 hours, 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- SEED & USER INITIALIZATION ---
# Default password applied to seed users (othmane, karime, packer, mehdi)
DEFAULT_USER_PASSWORD=nyrix2026

# --- SERVER RUNTIME ---
# Port assigned automatically by cloud hosts (Render, Heroku, etc.)
PORT=8000
